#!/usr/bin/python3
"""Agent job endpoint for the chat page (LuCI / plain Linux both work).

A single agent task takes minutes on this board, so this CGI only *starts* it
and hands back a job id; the page then polls for progress. Running it
synchronously would hit uhttpd's timeout.

  POST /cgi-bin/agent   {"task":"...", "max_steps":5, "readonly":false}
                        -> {"ok":1,"job":"ab12cd34"}
  GET  /cgi-bin/agent?job=ab12cd34
                        -> {"ok":1,"done":false,"output":"..."}
"""
import datetime
import json
import os
import shutil
import subprocess
import sys
import time

JOBS = "/tmp/agent-jobs"
JOB_KEEP_DAYS = 3          # job 按日期分目录，保留天数（跨日任务 + 余量）
WORK_DIR = "/tmp/llama_agent"          # agent 生成物的落地目录（tmpfs，重启清空）
RUN_LOCK = os.path.join(JOBS, ".running")   # 存正在跑的任务 pid
AGENT = "/opt/llama/agent/agent.py"
MAX_OUTPUT = 6000          # 页面只用来看进度，不需要全量日志


def _day_dir(day=None):
    d = os.path.join(JOBS, day or datetime.date.today().strftime("%Y%m%d"))
    os.makedirs(d, exist_ok=True)
    return d


def _job_path(jid, ext=".log"):
    """按 job id 找文件（今天是主要位置）。

    跨日连贯性：任务 23:59 启动、00:01 才轮询时必须还找得到，
    所以不能只看今天目录 —— 依次查今天 / 昨天 / 再往前到保留期。
    """
    today = datetime.date.today()
    for delta in range(0, JOB_KEEP_DAYS + 1):
        day = (today - datetime.timedelta(days=delta)).strftime("%Y%m%d")
        p = os.path.join(JOBS, day, jid + ext)
        if os.path.isfile(p):
            return p
    return None


def _prune_jobs():
    """按日期清：删掉超过保留天数的整个日期目录。

    运行中的任务永远落在今天目录里，不会被删；
    跨日任务最多跨 1 天，保留 3 天有足够余量。
    """
    today = datetime.date.today()
    try:
        for name in os.listdir(JOBS):
            p = os.path.join(JOBS, name)
            if os.path.isfile(p) and name.endswith((".log", ".task")):
                # 旧格式（平铺在 JOBS 根下）→ 新格式都进日期目录了，清掉
                try:
                    os.remove(p)
                except OSError:
                    pass
                continue
            if not os.path.isdir(p) or len(name) != 8 or not name.isdigit():
                continue                       # 跳过 .running 等非日期项
            try:
                d = datetime.datetime.strptime(name, "%Y%m%d").date()
            except ValueError:
                continue
            if (today - d).days > JOB_KEEP_DAYS:
                shutil.rmtree(p, ignore_errors=True)
    except OSError:
        pass


def send(obj):
    body = json.dumps(obj, ensure_ascii=False).encode()
    sys.stdout.write("Content-Type: application/json; charset=utf-8\r\n")
    sys.stdout.write("Cache-Control: no-store\r\n")
    sys.stdout.write("Access-Control-Allow-Origin: *\r\n")
    sys.stdout.write("Content-Length: %d\r\n\r\n" % len(body))
    sys.stdout.flush()
    sys.stdout.buffer.write(body)
    sys.stdout.buffer.flush()


def read_body():
    try:
        n = int(os.environ.get("CONTENT_LENGTH") or 0)
    except ValueError:
        n = 0
    if n <= 0:
        return ""
    return sys.stdin.read(n)


def _do_upload(raw):
    """POST /cgi-bin/agent?upload=1
    body = {"name": "报告.pdf", "data": "<base64>"}

    纯文本模型读不了二进制文档，所以这里上传即转换：
    存原文件 → extract.py 转文本 → 写 xxx.pdf.txt → 返回路径给页面。
    """
    import base64
    import re
    try:
        req = json.loads(raw or "{}")
        name = os.path.basename(str(req.get("name") or "").strip())
        blob = base64.b64decode(str(req.get("data") or ""))
    except Exception as exc:                                   # noqa: BLE001
        send({"ok": 0, "error": "上传参数错误: %s" % exc})
        return
    if not name:
        send({"ok": 0, "error": "缺少文件名"})
        return
    if len(blob) > 20 * 1024 * 1024:
        send({"ok": 0, "error": "文件太大（上限 20MB）"})
        return

    sys.path.insert(0, os.path.dirname(AGENT))
    try:
        import extract
    except Exception as exc:                                   # noqa: BLE001
        send({"ok": 0, "error": "extract.py 不可用（重新部署 agent）: %s" % exc})
        return
    if not extract.supported(name):
        send({"ok": 0, "error": "不支持 %s。支持 PDF / DOCX / XLSX / PPTX / 纯文本"
                                % os.path.splitext(name)[1]})
        return

    updir = os.path.join(WORK_DIR, "uploads")
    os.makedirs(updir, exist_ok=True)
    safe = re.sub(r"[^\w.\-\u4e00-\u9fff]", "_", name)[:80] or "upload"
    src = os.path.join(updir, safe)
    with open(src, "wb") as fh:
        fh.write(blob)
    try:
        text, info = extract.extract(src)
    except ValueError as exc:
        send({"ok": 0, "error": str(exc)})
        return
    txt = os.path.splitext(src)[0] + ".txt"      # 报告.pdf → 报告.txt（模型更容易猜对）
    with open(txt, "w", encoding="utf-8") as fh:
        fh.write(text)
    send({"ok": 1, "name": name, "file": txt, "info": info,
          "chars": len(text), "preview": text[:400]})


def main():
    _prune_jobs()          # 每次请求顺手清一次 job 日志（堆在 tmpfs 里占内存）
    os.makedirs(JOBS, exist_ok=True)
    method = (os.environ.get("REQUEST_METHOD") or "GET").upper()

    if method == "POST":
        raw = read_body()
        if "upload=1" in (os.environ.get("QUERY_STRING") or ""):
            _do_upload(raw)
            return
        try:
            data = json.loads(raw or "{}")
        except ValueError:
            send({"ok": 0, "error": "请求不是合法 JSON"})
            return
        task = (data.get("task") or "").strip()
        if not task:
            send({"ok": 0, "error": "任务为空"})
            return
        if not os.path.isfile(AGENT):
            send({"ok": 0, "error": "agent.py 不在 %s，先部署 agent" % AGENT})
            return

        # 单任务互斥：llama-server 是 np=1（一个 slot），并发跑多个 agent 只会
        # 互相排队，实测 5 个并发时单步从 60 秒涨到 472 秒。
        # 用 pid 文件而不是 pgrep -f：后者会误匹配终端里含 "agent.py -f" 的
        # ssh/bash 命令行，导致明明没任务在跑也被拒。
        if os.path.exists(RUN_LOCK):
            try:
                with open(RUN_LOCK) as fh:
                    busy_pid = int(fh.read().strip())
                os.kill(busy_pid, 0)          # 还活着？
                send({"ok": 0, "error": "已有 agent 任务在跑（pid %d）。"
                                        "llama-server 是单 slot，并发只会互相排队"
                                        "（实测慢 8 倍），等它结束再发。" % busy_pid})
                return
            except (OSError, ValueError):
                pass                          # 进程已退出，锁是脏的，继续

        jid = "%08x" % (int.from_bytes(os.urandom(4), "big"))
        dayd = _day_dir()
        task_file = os.path.join(dayd, jid + ".task")
        log_file = os.path.join(dayd, jid + ".log")
        with open(task_file, "w", encoding="utf-8") as fh:
            fh.write(task)

        try:
            steps = int(data.get("max_steps") or 5)
        except (TypeError, ValueError):
            steps = 5
        steps = max(1, min(steps, 8))

        cmd = [sys.executable or "python3", AGENT, "-f", task_file,
               "--max-steps", str(steps)]
        if data.get("readonly"):
            cmd.append("--readonly")

        # 关键：start_new_session 让任务不随 CGI 进程退出而结束
        with open(log_file, "w", encoding="utf-8") as fh:
            proc = subprocess.Popen(cmd, stdout=fh, stderr=subprocess.STDOUT,
                                    cwd=os.path.dirname(AGENT),
                                    start_new_session=True)
        try:
            with open(RUN_LOCK, "w") as lk:
                lk.write(str(proc.pid))
        except OSError:
            pass
        send({"ok": 1, "job": jid, "task": task, "pid": proc.pid})
        return

    # GET: 查进度
    qs = os.environ.get("QUERY_STRING") or ""
    params = {}
    for part in qs.split("&"):
        if "=" in part:
            k, v = part.split("=", 1)
            params[k] = v

    # 环境能力（页面点亮图标用）：直接问 C 框架
    if params.get("env") == "1":
        env = {}
        try:
            out = subprocess.run(
                ["/opt/llama/agent/agent-c", "--env",
                 "--plugins", "/opt/llama/agent/plugins"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                timeout=20)
            txt = (out.stdout or b"").decode("utf-8", "replace").strip()
            line = txt.splitlines()[-1] if txt else "{}"
            env = json.loads(line)
        except Exception:                                  # noqa: BLE001
            env = {}
        send({"ok": 1, "env": env})
        return

    # 文件下载：/cgi-bin/agent?file=bgm.mid
    # agent 生成在 /opt/llama/agent/ 下的 .mid / .pptx / .py 等，页面点链接就能存
    if params.get("file"):
        fname = os.path.basename(params["file"])      # 只取文件名，防目录穿越
        # 生成物在 /tmp/llama_agent（tmpfs，重启清空）。
        # 输出现在按 YYYYMMDD 分目录 → 依次查今天/昨天/保留期，
        # 再不济回落根目录和 uploads（旧文件、上传文件）。
        candidates = []
        for delta in range(0, JOB_KEEP_DAYS + 1):
            day = (datetime.date.today()
                   - datetime.timedelta(days=delta)).strftime("%Y%m%d")
            candidates.append(os.path.join(WORK_DIR, day, fname))
        candidates.append(os.path.join(WORK_DIR, fname))
        candidates.append(os.path.join(WORK_DIR, "uploads", fname))
        candidates.append(os.path.join(os.path.dirname(AGENT), fname))   # 旧版本遗留
        fpath = next((p for p in candidates if fname and os.path.isfile(p)), None)
        if not fpath:
            send({"ok": 0, "error": "文件不存在: %s（生成物在工作目录 %s/<日期>，重启后会被清空）"
                                    % (fname, WORK_DIR)})
            return
        ext = fname.rsplit(".", 1)[-1].lower() if "." in fname else ""
        ctype = {
            "mid": "audio/midi", "midi": "audio/midi",
            "wav": "audio/wav", "mp3": "audio/mpeg", "ogg": "audio/ogg",
            "pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "py": "text/plain; charset=utf-8",
            "md": "text/plain; charset=utf-8",
            "txt": "text/plain; charset=utf-8",
            "json": "application/json; charset=utf-8",
            "csv": "text/csv; charset=utf-8",
        }.get(ext, "application/octet-stream")
        size = os.path.getsize(fpath)
        sys.stdout.write("Content-Type: %s\r\n" % ctype)
        sys.stdout.write('Content-Disposition: attachment; filename="%s"\r\n' % fname)
        sys.stdout.write("Content-Length: %d\r\n" % size)
        sys.stdout.write("Cache-Control: no-store\r\n\r\n")
        sys.stdout.flush()
        with open(fpath, "rb") as fh:
            sys.stdout.buffer.write(fh.read())
        sys.stdout.buffer.flush()
        return
    jid = params.get("job", "").strip()
    if not jid or not jid.isalnum():
        send({"ok": 0, "error": "缺少 job 参数"})
        return
    # 跨日也能找到：查今天、昨天，一直到保留期
    log_file = _job_path(jid) or ""
    if not log_file:
        send({"ok": 0, "error": "任务不存在或已过期（保留 %d 天）" % JOB_KEEP_DAYS})
        return

    try:
        with open(log_file, "r", errors="replace") as fh:
            text = fh.read()
    except OSError as exc:
        send({"ok": 0, "error": "读日志失败: %s" % exc})
        return

    # agent 结束时会打印 [统计] 行；用它判断完成
    done = "[统计]" in text
    send({"ok": 1, "done": done, "output": text[-MAX_OUTPUT:]})


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:                                   # noqa: BLE001
        send({"ok": 0, "error": "CGI 异常: %s" % exc})
