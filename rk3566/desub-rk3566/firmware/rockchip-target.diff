diff --git a/target/linux/rockchip/armv8/base-files/etc/board.d/02_network b/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
index 48133c81..9757b95c 100755
--- a/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
+++ b/target/linux/rockchip/armv8/base-files/etc/board.d/02_network
@@ -11,6 +11,86 @@ rockchip_setup_interfaces()
 	friendlyarm,nanopi-r2s)
 		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
 		;;
+	hinlink,opc-h28k)
+		# eth0 is the on-board GMAC (RTL8211F RGMII PHY) and eth1 the
+		# RTL8111H sitting behind the PCIe x1 lane.  The PCIe NIC is a
+		# loadable module and therefore probes after the built-in GMAC,
+		# which is why the GMAC owns eth0.  These roles match 01_leds
+		# (WAN on eth1, LAN on eth0) and the vendor firmware.
+		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
+		;;
+	panther,x2)
+		# Single Gigabit port (SoC GMAC1 with an RTL8211F RGMII PHY), and it
+		# is the uplink: the board hangs off an existing network and gets
+		# its address by DHCP, so the port is the WAN, not a LAN bridge.
+		# (The "lan" zone is therefore empty; the wan zone is opened right
+		# below so that a freshly flashed headless box stays reachable.)
+		ucidef_set_interface_wan 'eth0' 'dhcp'
+
+		# The wan stays a plain device on purpose.  It was tried as a
+		# bridge over eth0 (so the wireless could be bridged onto the
+		# uplink), and on this board netifd never puts eth0 into it:
+		# bridge_add_member() -> device_get("eth0", true) yields nothing,
+		# a freshly created test bridge stays empty as well, while the same
+		# thing done with "ip link set eth0 master ..." works instantly.
+		# With the wan unusable the box boots with no address at all, so
+		# the wan is left as the bare port (proven reliable) and the
+		# wireless AP lives on the lan bridge instead.
+
+		# NOTE: pass a *placeholder* port here, never "br-lan".  The lan
+		# entry is special-cased in bin/config_generate:
+		#   [ "$1" = "lan" -a -z "$ports" ] && ports="$device"
+		# so it builds "config device br-lan { ports <device> }".  Passing
+		# br-lan itself yields a bridge whose only port is br-lan, netifd
+		# cannot bring it up, and the wireless (which hostapd attaches to
+		# br-lan) comes up nowhere either - the box then boots with no
+		# ethernet, no address and no SSID.  eth1 does not exist on this
+		# board; 95-panther-brlan turns the generated br-lan into an empty
+		# bridge (bridge_empty=1, ports removed) right afterwards, which is
+		# what the wireless AP needs as its L2 home.
+		ucidef_set_interface_lan 'eth1'
+
+		# Open the wan zone, because this script is the only place that is
+		# *known* to run for this board (it is what writes the network
+		# config below) - an uci-defaults file proved not to be enough, and
+		# getting locked out of a headless single-port box means a maskrom
+		# reflash.
+		uci -q set firewall.@defaults[0].input='ACCEPT'
+		uci -q set firewall.@defaults[0].forward='ACCEPT'
+		uci -q set firewall.@zone[1].input='ACCEPT'
+		uci -q set firewall.@zone[1].forward='ACCEPT'
+		uci -q set firewall.@zone[1].output='ACCEPT'
+		uci -q commit firewall
+
+		# Note: a static address on the dhcp wan (list ipaddr) is *not*
+		# applied by netifd, so there is no fixed fallback address here; the
+		# port carries the upstream lease only.
+		;;
+	jp-tvbox,rk3566)
+		# Single Gigabit port (SoC GMAC1 with an RGMII PHY, MDIO address
+		# 1).  Same arrangement as panther,x2 and for the same reason: the
+		# port is the uplink and takes a lease, while the wireless AP is
+		# attached to a "lan" bridge that has no physical member (this box
+		# has no second port and no SD slot).  The firewall is opened for
+		# the wan zone as well, so the freshly flashed box is reachable at
+		# the address it leased; the full rationale for each step is in the
+		# panther,x2 block above.
+		ucidef_set_interface_wan 'eth0' 'dhcp'
+		# Placeholder port (see the long note in the panther,x2 block):
+		# config_generate turns "lan" + device into "config device br-lan
+		# { ports <device> }", so it must not be "br-lan" itself, and it
+		# must not be empty either - with no device the lan interface is
+		# not generated at all, dnsmasq then has no dhcp-range and every
+		# wireless client is left without an address.
+		ucidef_set_interface_lan 'eth1'
+
+		uci -q set firewall.@defaults[0].input='ACCEPT'
+		uci -q set firewall.@defaults[0].forward='ACCEPT'
+		uci -q set firewall.@zone[1].input='ACCEPT'
+		uci -q set firewall.@zone[1].forward='ACCEPT'
+		uci -q set firewall.@zone[1].output='ACCEPT'
+		uci -q commit firewall
+		;;
 	*)
 		ucidef_set_interface_lan 'eth0'
 		;;
@@ -24,6 +104,61 @@ nanopi_r2s_generate_mac()
 	echo "$(macaddr_unsetbit_mc "$(macaddr_setbit_la "${mac_base}")")"
 }
 
+panther_x2_generate_mac()
+{
+	# Stable per-board MAC derived from the onboard eMMC CID, falling back
+	# to the SD card CID and finally to the SoC serial.  The optional tag
+	# mixes in a per-interface string so one board can derive several
+	# *distinct* stable addresses.
+	#
+	# The CID is looked up in both mmc numbering schemes on purpose: on
+	# panther,x2 the eMMC is mmc1 (/dev/mmcblk1), on jp_tv it is mmc0
+	# (/dev/mmcblk0), and the DT alias decides which one it is.
+	local tag="$1" seed="" f
+	for f in /sys/class/mmc_host/mmc1/mmc1:*/cid \
+		 /sys/block/mmcblk1/device/cid \
+		 /sys/class/mmc_host/mmc0/mmc0:*/cid \
+		 /sys/block/mmcblk0/device/cid \
+		 /proc/device-tree/serial-number; do
+		[ -r "$f" ] || continue
+		seed=$(cat "$f" 2>/dev/null)
+		[ -n "$seed" ] && break
+	done
+	[ -z "$seed" ] && seed="$(board_name)"
+
+	local hash=$(printf '%s-%s' "$seed" "$tag" | sha256sum | cut -c1-12)
+	local mac_base=$(macaddr_canonicalize "$hash")
+	[ -z "$mac_base" ] && mac_base="02:00:00:00:00:01"
+
+	echo "$(macaddr_unsetbit_mc "$(macaddr_setbit_la "${mac_base}")")"
+}
+
+h28k_generate_mac()
+{
+	# Stable per-box MAC derived from the onboard eMMC CID (mmc1 in the DT
+	# aliases, i.e. /dev/mmcblk1 on this board), falling back to the SD
+	# card and finally to the SoC serial if no CID is readable yet.  The
+	# optional tag mixes in a per-interface string so one board can derive
+	# several *distinct* stable addresses.
+	local tag="$1" seed="" f
+	for f in /sys/class/mmc_host/mmc1/mmc1:*/cid \
+		 /sys/block/mmcblk1/device/cid \
+		 /sys/class/mmc_host/mmc0/mmc0:*/cid \
+		 /sys/block/mmcblk0/device/cid \
+		 /proc/device-tree/serial-number; do
+		[ -r "$f" ] || continue
+		seed=$(cat "$f" 2>/dev/null)
+		[ -n "$seed" ] && break
+	done
+	[ -z "$seed" ] && seed="hinlink-opc-h28k"
+
+	local hash=$(printf '%s-%s' "$seed" "$tag" | sha256sum | cut -c1-12)
+	local mac_base=$(macaddr_canonicalize "$hash")
+	[ -z "$mac_base" ] && mac_base="02:00:00:00:00:01"
+
+	echo "$(macaddr_unsetbit_mc "$(macaddr_setbit_la "${mac_base}")")"
+}
+
 rockchip_setup_macs()
 {
 	local board="$1"
@@ -32,10 +167,33 @@ rockchip_setup_macs()
 	local label_mac=""
 
 	case "$board" in
+	panther,x2)
+		# See the note in the h28k case below: a single address must not
+		# be shared between an interface and its members, so set it per
+		# network device.
+		ucidef_set_network_device_mac eth0 "$(panther_x2_generate_mac lan)"
+		;;
+	jp-tvbox,rk3566)
+		# Same eMMC-CID derived address as panther,x2; no vendor
+		# ethernet-MAC is stored anywhere readable on this box.
+		ucidef_set_network_device_mac eth0 "$(panther_x2_generate_mac lan)"
+		;;
 	friendlyarm,nanopi-r2s)
 		wan_mac=$(nanopi_r2s_generate_mac)
 		lan_mac=$(macaddr_add "$wan_mac" +1)
 		;;
+	hinlink,opc-h28k)
+		# One stable MAC per *port* (same idea as target/linux/realtek).
+		#
+		# Note we must NOT use ucidef_set_interface_macaddr "lan" here: while
+		# both ports sit in the LAN bridge, generate_network() in
+		# bin/config_generate copies that single address onto the bridge AND
+		# onto every member port, and a bridge sharing its address with its
+		# members drops frames - DHCP replies included - so the board looks
+		# perfectly healthy while no client ever gets a lease.
+		ucidef_set_network_device_mac eth0 "$(h28k_generate_mac lan)"
+		ucidef_set_network_device_mac eth1 "$(h28k_generate_mac wan)"
+		;;
 	esac
 
 	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
