 # CONFIG_NVME_MULTIPATH is not set
@@ -380,6 +382,20 @@ CONFIG_ROCKCHIP_GRF=y
 CONFIG_ROCKCHIP_IODOMAIN=y
 CONFIG_ROCKCHIP_IOMMU=y
 CONFIG_ROCKCHIP_MBOX=y
+# Rockchip vendor video codec (MPP) stack.  Every symbol is tristate (=m) and
+# the whole stack links into the single module rk_vcodec.ko, which is packaged
+# as kmod-rk-vcodec (target/linux/rockchip/modules.mk) and installed only by
+# the devices that list it in DEVICE_PACKAGES (panther_x2).  The remaining
+# rockchip boards build the module from this shared subtarget config but never
+# install or load it, so MPP is device-isolated without a per-device config.
+CONFIG_ROCKCHIP_MPP_SERVICE=m
+# CONFIG_ROCKCHIP_MPP_DEVFREQ is not set
+CONFIG_ROCKCHIP_MPP_PROC_FS=m
+CONFIG_ROCKCHIP_MPP_RKVDEC2=m
+CONFIG_ROCKCHIP_MPP_RKVENC=m
+CONFIG_ROCKCHIP_MPP_VDPU2=m
+CONFIG_ROCKCHIP_MPP_VEPU2=m
+CONFIG_ROCKCHIP_MPP_JPGDEC=m
 CONFIG_ROCKCHIP_PHY=y
 CONFIG_ROCKCHIP_PM_DOMAINS=y
 # CONFIG_ROCKCHIP_SARADC is not set
@@ -392,7 +408,7 @@ CONFIG_RTC_I2C_AND_SPI=y
 CONFIG_RTC_NVMEM=y
 # CONFIG_RUNTIME_TESTING_MENU is not set
 CONFIG_SCHED_MC=y
-CONFIG_SCSI=y
+CONFIG_SCSI=m
 # CONFIG_SCSI_LOWLEVEL is not set
 # CONFIG_SCSI_PROC_FS is not set
 CONFIG_SCSI_SAS_ATTRS=y
@@ -511,3 +527,138 @@ CONFIG_XZ_DEC_ARMTHUMB=y
 CONFIG_XZ_DEC_BCJ=y
 CONFIG_ZLIB_DEFLATE=y
 CONFIG_ZLIB_INFLATE=y
+
+# RK3528 PCIe (2nd ethernet port: RTL8168 on PCIe)
+CONFIG_PCIE_DW_ROCKCHIP=y
+CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
+
+# RTL8168 gigabit NIC on PCIe (2nd physical port of OPC-H28K)
+# CONFIG_R8169 is not set
+CONFIG_LEDS_TRIGGER_HEARTBEAT=y
+CONFIG_LEDS_TRIGGER_NETDEV=y
+CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
+CONFIG_LEDS_TRIGGER_TIMER=y
+CONFIG_PSTORE=y
+CONFIG_PSTORE_RAM=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_PMSG=y
+CONFIG_PSTORE_DEFAULT_KMSG_SIZE=262144
+CONFIG_PSTORE_DEFLATE_COMPRESS=y
+CONFIG_PSTORE_DEFLATE_COMPRESS_DEFAULT=y
+# CONFIG_PSTORE_LZO_COMPRESS is not set
+# CONFIG_PSTORE_LZ4_COMPRESS is not set
+# CONFIG_PSTORE_LZ4HC_COMPRESS is not set
+# CONFIG_PSTORE_842_COMPRESS is not set
+# CONFIG_PSTORE_ZSTD_COMPRESS is not set
+
+# RK3566/RK3568 NPU (rknpu), back-ported from the vendor 5.10 driver.
+# DRM is required because the driver registers itself as a DRM render
+# node (/dev/dri/renderD*), which is what the RKNN userspace looks for.
+#
+# These symbols are global to the whole rockchip/armv8 subtarget and cannot be
+# made per-device: OpenWrt 21.02 has no per-device kernel config, and RKNPU has
+# to stay =y because the memory-manager choice at the bottom of this file is a
+# bool under "if ROCKCHIP_RKNPU" (a bool whose tristate parent is =m is
+# silently forced to =n, which would disable the DMA-heap path the RKNN
+# userspace uses).  They are nevertheless harmless on the other rockchip boards
+# that share this config:
+#
+#   * rknpu_of_match[] only lists rockchip,rknpu / rk3568-rknpu / rk3588-rknpu /
+#     rv1106 / rv1103b / rk3562 / rk3576.  None of rk3328, rk3399 or rk3528 has
+#     an rknpu DT node, so rknpu_probe() is never called there: the driver only
+#     registers a platform_driver at late_initcall and does nothing else (no
+#     clock/regulator/IRQ/IOMMU request, no /dev/rknpu, no misc device).
+#   * CONFIG_DRM=y is the generic DRM subsystem only (CONFIG_DRM_ROCKCHIP stays
+#     off); it has no SoC-specific side effect.
+#
+# The only cost on the other boards is a few tens of KB of unused vmlinux text.
+CONFIG_DRM=y
+CONFIG_DRM_VGEM=y
+CONFIG_ROCKCHIP_RKNPU=y
+# CONFIG_ROCKCHIP_RKNPU_DRM_GEM is not set
+CONFIG_ROCKCHIP_RKNPU_DEBUG_FS=y
+
+# The Panther X2's Bluetooth is a BCM43430A1 on UART and needs the BCM
+# protocol driver (btbcm) to upload brcm/BCM43430A1.hcd.  kmod-bluetooth
+# asks for HCIUART_BCM=n in its KCONFIG; whether the target config here
+# wins over that has to be confirmed by checking the generated .config.
+CONFIG_BT_HCIUART_BCM=y
+# NOTE: btbcm cannot be forced to =y here - it is only reachable through
+# selects from BT_HCIUART/BT_HCIBTUSB, which are modules, so kconfig keeps
+# it at =m.  btbcm.ko is therefore packaged by the small kmod-btbcm
+# package in package/kernel/btbcm (selected by the panther_x2 device),
+# which is what makes kmod-bluetooth's hci_uart.ko dependency resolve.
+
+# The BCM43430A1 Bluetooth is on UART and its DT node is
+# "brcm,bcm43438-bt", which only hci_bcm.c matches - so HCIUART_BCM has to
+# be on.  That makes hci_uart link against the btbcm helper, and btbcm can
+# only ever be a *module* here (it is pulled in by selects from BT_HCIUART/
+# BT_HCIBTUSB), which would leave hci_uart.ko with a dependency that
+# kmod-bluetooth does not ship.  Building the BT core and the UART/BCM code
+# into the kernel instead keeps module dependencies empty and still uploads
+# brcm/BCM43430A1.hcd at probe time.  USB Bluetooth dongles are not needed
+# on this board (no USB host at all), hence BT_HCIBTUSB=n.
+CONFIG_BT=y
+CONFIG_BT_BCM=y
+CONFIG_BT_HCIUART=y
+CONFIG_BT_HCIUART_BCM=y
+CONFIG_BT_HCIBTUSB=n
+
+# With the Bluetooth stack built in, hci_bcm probes long before the
+# squashfs root is mounted, so the request_firmware() lookup of
+# brcm/BCM43430A1.hcd fails ("Patch not found") even though the file
+# ships in /lib/firmware.  Embedding it in the kernel image fixes that;
+# the directory is relative to the kernel build tree (target files/ is
+# copied to its root by the kernel prepare step).
+CONFIG_EXTRA_FIRMWARE="brcm/BCM43430A1.hcd"
+CONFIG_EXTRA_FIRMWARE_DIR="firmware"
+
+# Debugging aids kept in the image on purpose: /dev/mem lets us read the
+# USBGRF/PHY registers directly (the USB port stops detecting re-connects),
+# and dynamic debug gives per-driver traces without rebuilding.
+CONFIG_DYNAMIC_DEBUG=y
+# CONFIG_STRICT_DEVMEM is not set
+# Vendor + mainline dma-buf heaps backing the NPU memory path.
+#
+# These are global to the subtarget for the same reason as the rknpu symbols
+# above: ROCKCHIP_RKNPU_DMA_HEAP is a bool that depends on
+# DMABUF_HEAPS_ROCKCHIP_CMA_HEAP, so the vendor CMA heap has to be built in
+# (=y) as well, and the mainline DMABUF_HEAPS framework is itself a bool.
+# None of this runs on a board whose DT has no rknpu node, and none of it
+# allocates memory at init:
+#   * rk_dma_heap_init() only allocates a chardev region, creates a class and a
+#     procfs directory; rk_cma_heap_init() only registers the "rk-dma-heap-cma"
+#     heap and bails out cleanly (-ENODEV, no crash) if no CMA area exists.
+#   * the mainline system heap only registers /dev/dma_heap/system; it reserves
+#     nothing until a process opens the chardev.
+# So rk3328/rk3399/rk3528 only gain a few extra chardev nodes, with no change
+# in behaviour.
+CONFIG_ROCKCHIP_RKNPU_DMA_HEAP=y
+CONFIG_DMABUF_HEAPS_ROCKCHIP=y
+CONFIG_DMABUF_HEAPS_ROCKCHIP_CMA_HEAP=y
+CONFIG_DMABUF_HEAPS_ROCKCHIP_CMA_ALIGNMENT=8
+# Mainline (upstream) DMA-BUF heaps framework + system heap, backported from
+# the vendor develop-5.10 tree.  Built-in (=y) so that /dev/dma_heap/system
+# exists before the RKNN userspace runtime starts.
+CONFIG_DMABUF_HEAPS=y
+CONFIG_DMABUF_HEAPS_DEFERRED_FREE=y
+CONFIG_DMABUF_HEAPS_PAGE_POOL=y
+CONFIG_DMABUF_HEAPS_SYSTEM=y
+CONFIG_ROCKCHIP_MULTI_RGA=y
+CONFIG_ROCKCHIP_RGA_ASYNC=y
+CONFIG_ROCKCHIP_RGA_PROC_FS=y
+# CONFIG_ROCKCHIP_RGA_DEBUG_FS is not set
+CONFIG_ROCKCHIP_RGA_GENPOOL=y
+CONFIG_ROCKCHIP_RGA_CMD_BUF_COUNT=32
+# CONFIG_DMABUF_RK_HEAPS_DEBUG is not set
+# CONFIG_DMABUF_RK_HEAPS_DEBUG_PRINT is not set
+CONFIG_ROCKCHIP_RKNPU_PROC_FS=y
+CONFIG_ROCKCHIP_RKNPU_FENCE=y
+
+# This tree's wireless Kconfig already carries the "Vendor: ..." grouping menus
+# (backported from 5.10), so the Broadcom vendor symbol has to be enabled or
+# drivers/net/wireless/broadcom/* - including brcmfmac - is not even visible
+# and kmod-brcmfmac cannot set CONFIG_BRCMFMAC at all.  It is a visibility bool
+# with no runtime effect: drivers are still only built when their own symbol is
+# selected by a kmod, so the sibling boards are unaffected.
+CONFIG_WLAN_VENDOR_BROADCOM=y
